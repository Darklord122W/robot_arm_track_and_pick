<?xml version="1.0"?>
<robot name="xarm_1s">

  <!-- Virtual joint: world to base_link -->
  <virtual_joint
      name="world_joint"
      type="fixed"
      parent_frame="world"
      child_link="base_link" />

  <!-- Arm group: chain from base_link to tool0. arm1 (gripper master) is
       NOT in this chain — it's a sibling branch off link2 — so it stays
       outside MoveIt and is controlled by xarm_hw.gripper.move_gripper.
       This makes tool0 the KDL chain tip, so move_to_pose(link='tool0')
       resolves cleanly. -->
  <group name="arm">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="arm2" value="0"/>
    <joint name="arm3" value="0"/>
    <joint name="arm4" value="0"/>
    <joint name="arm5" value="0"/>
    <joint name="arm6" value="0"/>
  </group_state>

  
  <!-- Base -->
  <disable_collisions link1="base_link" link2="link0"      reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="link0_left" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="link6"      reason="Adjacent"/>

  <!-- Gripper parallel linkage: all pairs within {link0, link0_left, link1, link1_left} -->
  <disable_collisions link1="link0"      link2="link0_left" reason="Adjacent"/>
  <disable_collisions link1="link0"      link2="link1"      reason="Adjacent"/>
  <disable_collisions link1="link0"      link2="link1_left" reason="Never"/>
  <disable_collisions link1="link0"      link2="link2"      reason="Never"/>
  <disable_collisions link1="link0_left" link2="link1"      reason="Never"/>
  <disable_collisions link1="link0_left" link2="link1_left" reason="Adjacent"/>
  <disable_collisions link1="link0_left" link2="link2"      reason="Never"/>
  <disable_collisions link1="link1"      link2="link1_left" reason="Adjacent"/>
  <disable_collisions link1="link1"      link2="link2"      reason="Adjacent"/>
  <disable_collisions link1="link1_left" link2="link2"      reason="Adjacent"/>

  <!-- Arm chain -->
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
</robot>
